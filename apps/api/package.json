{
  "name": "@reziproq/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:test-tools": "tsc -p tsconfig.test-build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently --raw --kill-others \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch --enable-source-maps dist/main.js\"",
    "start": "NODE_ENV=production node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "rechte": "tsc -p tsconfig.build.json && node dist/rights-cli.js",
    "demo:suppliers": "pnpm build && node dist/modules/suppliers/generate-demo.js",
    "demo:ki": "pnpm build && node dist/demo-ki-cli.js"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.130",
    "@ai-sdk/anthropic": "4.0.94",
    "@aws-sdk/credential-provider-node": "3.972.92",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/serve-static": "12.1.1",
    "@reziproq/db": "workspace:*",
    "@reziproq/shared": "workspace:*",
    "ai": "7.0.159",
    "exceljs": "4.4.0",
    "express": "5.3.0",
    "fflate": "0.8.2",
    "jose": "6.2.13",
    "nodemailer": "10.3.1",
    "pg-boss": "12.38.0",
    "playwright-core": "1.64.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "concurrently": "10.0.6",
    "pdfjs-dist": "5.4.394",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
