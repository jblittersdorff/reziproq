{
  "name": "reziproq",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node scripts/dev-guard.mjs && pnpm --filter \"./packages/*\" build && pnpm --recursive --parallel dev",
    "dev:stop": "node scripts/dev-stop.mjs",
    "vorschau": "node scripts/vorschau.mjs",
    "vorschau:stop": "node scripts/vorschau.mjs stop",
    "vorschau:status": "node scripts/vorschau.mjs status",
    "build": "pnpm --recursive build",
    "start": "pnpm --filter @reziproq/api start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "pnpm typecheck && pnpm lint && pnpm db:migrate && pnpm db:roles && pnpm test && pnpm test:perf && pnpm test:e2e",
    "check:biome": "biome check .",
    "typecheck": "pnpm --recursive typecheck",
    "test": "vitest run",
    "test:perf": "REZIPROQ_PERF=1 vitest run --project api src/modules/suppliers/ls-01.test.ts src/modules/overview/zyk-04.test.ts",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @reziproq/web test:e2e && pnpm --filter @reziproq/website test:e2e",
    "website": "pnpm --filter @reziproq/website dev",
    "db:generate": "pnpm --filter @reziproq/db db:generate",
    "db:migrate": "pnpm --filter @reziproq/db db:migrate",
    "db:seed": "pnpm --filter @reziproq/db db:seed",
    "db:roles": "pnpm --filter @reziproq/db db:roles",
    "org:link": "pnpm --filter @reziproq/db org:link",
    "operator:set": "pnpm --filter @reziproq/db operator:set",
    "rechte": "pnpm --filter @reziproq/api rechte",
    "weiterleitungen": "WEITERLEITUNGEN_SCHREIBEN=1 vitest run --project web route-moves",
    "demo:setup": "pnpm --filter @reziproq/db demo:setup && pnpm --filter @reziproq/api demo:ki",
    "demo:hollmann": "pnpm --filter @reziproq/db demo:hollmann",
    "durchstich:pruefen": "pnpm --filter @reziproq/db durchstich:pruefen",
    "durchstich:graph": "pnpm --filter @reziproq/api durchstich:graph"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
