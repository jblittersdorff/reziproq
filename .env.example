# Verbindung zur lokalen Datenbank aus docker-compose.yml – als Eigentümer der Tabellen.
# Nur für Migrationen und Skripte (db:migrate, db:seed, db:roles, org:link).
DATABASE_URL=postgres://reziproq:reziproq_local@localhost:5433/reziproq

# Verbindung der API: Rolle reziproq_api, nicht Eigentümer, ohne Sonderrechte (PLT-02).
# Nach db:migrate einmal `pnpm db:roles` ausführen; das setzt Login und dieses Passwort.
API_DATABASE_URL=postgres://reziproq_api:reziproq_api_local@localhost:5433/reziproq

# Hintergrundjobs (QS-01), eigene Rolle für Outbox und pg-boss.
JOBS_DATABASE_URL=postgres://reziproq_jobs:reziproq_jobs_local@localhost:5433/reziproq

# Mailpit lokal (docker compose up -d); in Staging später SMTP über SES.
EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
WEB_APP_URL=http://localhost:5173

# Adresse der Zitadel-Instanz, z. B. https://meine-instanz.zitadel.cloud (ohne / am Ende)
ZITADEL_ISSUER=

# Client-ID der Web-App in Zitadel (Typ „User Agent“, PKCE)
ZITADEL_CLIENT_ID=

# ID des Zitadel-Projekts; die API erwartet sie als Audience im Access Token (nur die API braucht sie)
ZITADEL_PROJECT_ID=

# Lieferanten einladen (LIF-01): fake legt Organisation und Person nur nachgebaut an (ohne Internet).
# zitadel nutzt die Verwaltungsschnittstelle; dafür ein Dienstkonto mit Personal Access Token, das
# Organisationen und Nutzer anlegen darf (Instanz-Manager-Rolle, z. B. IAM_ORG_MANAGER).
# Im Betrieb ist die Annahme von Einladungen mit fake ausgeschaltet.
IDENTITY_PROVIDER=fake
ZITADEL_SERVICE_TOKEN=

# KI für Fragen (PLT-12): „test“ ist ein festes Modell ohne Schlüssel und Internet.
# „anthropic“ ist nur für Beispieldaten; mit echten Daten läuft die API über Bedrock in der EU.
AI_PROVIDER=test

# Anthropic-Modell-ID oder Bedrock-Modell-ID passend zum Anbieter
AI_MODEL=claude-haiku-5-5

# Schlüssel für AI_PROVIDER=anthropic, aus console.anthropic.com
ANTHROPIC_API_KEY=

# AWS-Region für AI_PROVIDER=bedrock; Credentials kommen aus der AWS SDK Default Provider Chain
# (lokal z. B. aws sso login, auf AWS über die IAM-Rolle der Laufzeitumgebung).
AWS_REGION=

# Höchstzahl Fragen je Nutzer und Minute
AI_REQUESTS_PER_MINUTE=10

# IN-01: Schlüssel für die Zugangsdaten der Anbindungen (mindestens 16 Zeichen, nie ins Repository).
# Lokal leer: dann gilt ein Schlüssel nur für die Laufzeit der API, verbundene Anbindungen müssen
# nach einem Neustart neu verbunden werden. Im Betrieb Pflicht, aus dem Schlüsseldienst in der EU.
CONNECTION_SECRET_KEY=
